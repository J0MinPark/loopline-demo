<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('partials/head', { title: '회원가입 — Loopline' }) %>
</head>
<body>
  <%- include('partials/nav', { user: null }) %>

  <div class="auth-wrap">
    <div class="auth-card">
      <h1>무료로 시작하기</h1>
      <p class="sub">가입 즉시 이메일로 인증 코드를 보내드려요.</p>

      <% if (error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/signup">
        <div class="field">
          <label for="name">이름</label>
          <input type="text" id="name" name="name" placeholder="홍길동" required />
        </div>
        <div class="field">
          <label for="email">이메일</label>
          <input type="email" id="email" name="email" placeholder="you@company.com" required />
        </div>
        <div class="field">
          <label for="password">비밀번호</label>
          <input type="password" id="password" name="password" placeholder="8자 이상" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">인증 코드 받기</button>
      </form>

      <div class="auth-foot">이미 계정이 있으신가요? <a href="/login">로그인</a></div>
    </div>
  </div>
</body>
</html>
